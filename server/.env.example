# ---------- Core ----------
NODE_ENV=development
PORT=4000
# Public URL of the web app (used for CORS, invite links and Stripe redirects)
APP_URL=http://localhost:5173
# Long random string: `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string

DATABASE_URL=postgresql://portal:portal@localhost:5433/portal?schema=public

# ---------- File storage ----------
# STORAGE_DRIVER=s3     -> AWS S3, Cloudflare R2 or MinIO (presigned direct uploads)
# STORAGE_DRIVER=local  -> files stored on the server's disk (no cloud needed)
STORAGE_DRIVER=s3
S3_BUCKET=client-portal
S3_REGION=us-east-1
# Local MinIO (docker). For AWS S3 leave S3_ENDPOINT empty.
# For Cloudflare R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com and S3_REGION=auto
S3_ENDPOINT=http://localhost:9010
S3_ACCESS_KEY_ID=portal-minio
S3_SECRET_ACCESS_KEY=portal-minio-secret
S3_FORCE_PATH_STYLE=true
# Create the bucket on startup if missing (handy for MinIO; leave false for prod)
S3_AUTO_CREATE_BUCKET=true
MAX_UPLOAD_MB=100

# ---------- Stripe ----------
# Test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:4000/api/webhooks/stripe` or the dashboard
STRIPE_WEBHOOK_SECRET=

# ---------- Email (optional) ----------
# e.g. smtp://user:pass@smtp.mailtrap.io:2525 — when empty, invite links are shown in the UI
SMTP_URL=
EMAIL_FROM="Client Portal <no-reply@example.com>"
