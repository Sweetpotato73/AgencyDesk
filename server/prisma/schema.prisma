generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Tenancy & users ───────────────────────────

/// An agency / firm / freelancer workspace. Everything is scoped to one.
model Organization {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  brandColor String   @default("#4f46e5")
  logoKey    String?  // storage key of uploaded logo
  currency   String   @default("usd")
  createdAt  DateTime @default(now())

  users    User[]
  clients  Client[]
  projects Project[]
  invoices Invoice[]
  files    File[]
  invites  Invite[]
  invoiceCounter Int @default(0)
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  CLIENT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role
  orgId        String
  clientId     String? // only for role CLIENT
  createdAt    DateTime @default(now())
  lastSeenAt   DateTime?
  /// Removed users are deactivated (not deleted) so their comments and files stay intact.
  deactivatedAt DateTime?

  org            Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client         Client?        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  comments       Comment[]
  files          File[]
  notifications  Notification[]
  assignedTasks  Task[]         @relation("TaskAssignee")
  activities     Activity[]

  @@index([orgId])
  @@index([clientId])
}

/// A customer company of the agency.
model Client {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  email     String?
  phone     String?
  createdAt DateTime @default(now())

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  users    User[]
  projects Project[]
  invoices Invoice[]
  invites  Invite[]

  @@index([orgId])
}

model Invite {
  id         String    @id @default(cuid())
  orgId      String
  email      String
  role       Role
  clientId   String?
  tokenHash  String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

// ─────────────────────────── Projects & work ───────────────────────────

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
}

model Project {
  id          String        @id @default(cuid())
  orgId       String
  clientId    String
  name        String
  description String        @default("")
  status      ProjectStatus @default(ACTIVE)
  dueDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client     Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  milestones Milestone[]
  tasks      Task[]
  comments   Comment[]
  files      File[]
  invoices   Invoice[]
  activities Activity[]

  @@index([orgId])
  @@index([clientId])
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  AWAITING_APPROVAL
  CHANGES_REQUESTED
  APPROVED
}

model Milestone {
  id           String          @id @default(cuid())
  projectId    String
  title        String
  description  String          @default("")
  status       MilestoneStatus @default(PENDING)
  dueDate      DateTime?
  position     Int             @default(0)
  submittedAt  DateTime?
  decidedAt    DateTime?
  decidedById  String?
  decisionNote String?
  createdAt    DateTime        @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]
  files   File[]

  @@index([projectId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

model Task {
  id            String     @id @default(cuid())
  projectId     String
  milestoneId   String?
  title         String
  description   String     @default("")
  status        TaskStatus @default(TODO)
  assigneeId    String?
  dueDate       DateTime?
  clientVisible Boolean    @default(true)
  position      Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  assignee  User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments  Comment[]
  files     File[]

  @@index([projectId])
}

/// Message in a project's discussion (taskId = null) or on a task.
model Comment {
  id        String    @id @default(cuid())
  projectId String
  taskId    String?
  authorId  String
  body      String
  editedAt  DateTime?
  createdAt DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([projectId, taskId, createdAt])
}

enum FileStatus {
  PENDING
  READY
}

model File {
  id          String     @id @default(cuid())
  orgId       String
  projectId   String
  taskId      String?
  milestoneId String?
  uploaderId  String
  name        String
  size        Int
  mimeType    String
  storageKey  String     @unique
  status      FileStatus @default(PENDING)
  createdAt   DateTime   @default(now())

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task      Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  milestone Milestone?   @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  uploader  User         @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
}

// ─────────────────────────── Billing ───────────────────────────

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
}

model Invoice {
  id                    String        @id @default(cuid())
  orgId                 String
  clientId              String
  projectId             String?
  number                String
  status                InvoiceStatus @default(DRAFT)
  currency              String        @default("usd")
  dueDate               DateTime?
  notes                 String        @default("")
  issuedAt              DateTime?
  paidAt                DateTime?
  stripeSessionId       String?       @unique
  stripePaymentIntentId String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  org     Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client  Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  items   InvoiceItem[]

  @@unique([orgId, number])
  @@index([clientId])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int     @default(1)
  unitAmount  Int // in the smallest currency unit (cents)
  position    Int     @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

// ─────────────────────────── Notifications & activity ───────────────────────────

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String    @default("")
  link      String    @default("")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model Activity {
  id        String   @id @default(cuid())
  projectId String
  actorId   String
  verb      String // e.g. "uploaded", "approved"
  summary   String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   User    @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}
